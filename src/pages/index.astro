---
import BlogList from "../components/BlogList.astro";
import ContactMe from "../components/ContactMe.astro";
import PersonalBio from "../components/PersonalBio.astro";
import SectionBreak from "../components/SectionBreak.astro";
import Subheading from "../components/Subheading.astro";
import GithubIcon from "../components/icons/GithubIcon.astro";
import TwitterIcon from "../components/icons/TwitterIcon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="@jackblatch">
  <div class="animate-fade-in">
    <main>
      <PersonalBio />
      <div
        class="mt-6 flex items-center gap-4 text-ink-muted dark:text-night-muted"
      >
        <a
          href="https://github.com/jackblatch"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="hover:text-accent transition-colors"
        >
          <GithubIcon />
        </a>
        <a
          href="https://twitter.com/jackblatch_"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter"
          class="hover:text-accent transition-colors"
        >
          <TwitterIcon />
        </a>
      </div>
    </main>
    <SectionBreak />
    <div class="flex flex-col gap-10">
      <div>
        <Subheading text="Blog" />
        <BlogList />
      </div>
      <ContactMe />
    </div>
  </div>
</Layout>
