---
import ArrowTopRightOnSquareIcon from "./ArrowTopRightOnSquareIcon.astro";

export interface Props {
  link: string;
  text: string;
}

const { link, text } = Astro.props;
---

<a
  class="flex items-center gap-1 text-xs text-ink-muted dark:text-night-muted hover:text-ink-fg dark:hover:text-night-fg transition-colors"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  >{text}
  <ArrowTopRightOnSquareIcon /></a
>
