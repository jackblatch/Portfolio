---
export interface Props {
  text: string;
  highlight?: boolean;
}

const { text, highlight = false } = Astro.props;
---

<h1 class="text-base font-medium tracking-tight mb-0">
  {
    highlight ? (
      <span class="inline-block bg-accent text-on-accent px-1">
        {text}
      </span>
    ) : (
      text
    )
  }
</h1>
