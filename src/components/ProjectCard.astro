---
import CardWrapper from "./CardWrapper.astro";
import ProjectCardLink from "./ProjectCardLink.astro";
import StarIcon from "./StarIcon.astro";

export interface Props {
  title: string;
  body: string;
  githubLink: string;
  deployedLink: string;
  starCount: string;
}

const { githubLink, deployedLink, title, body, starCount } = Astro.props;
---

<CardWrapper>
  <div class="flex flex-col justify-between h-full">
    <div>
      <h4 class="text-sm font-medium">
        {title}
      </h4>
      <p class="mt-2 text-sm text-ink-muted dark:text-night-muted line-clamp-2">
        {body}
      </p>
    </div>
    <div
      class="flex-col sm:flex-row gap-2 mt-4 flex items-start sm:items-center justify-center sm:justify-between"
    >
      <div class="flex items-center justify-start gap-4">
        <ProjectCardLink link={githubLink} text="GitHub" />
        <ProjectCardLink link={deployedLink} text="Visit" />
      </div>
      <div
        class="flex items-center gap-1 text-xs text-ink-muted dark:text-night-muted tabular-nums"
      >
        {starCount}
        <StarIcon />
      </div>
    </div>
  </div>
</CardWrapper>
