---
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
---

<section>
  <ul class="list-none flex flex-col">
    {
      allPosts
        // @ts-ignore
        .sort((a, b) => b.index - a.index)
        .map((post) => (
          <li class="border-t border-ink-line dark:border-night-line last:border-b">
            <a
              href={`/blog/${post.slug}`}
              class="group relative flex items-baseline justify-between gap-4 py-3 pl-4 text-sm"
            >
              <span
                aria-hidden="true"
                class="absolute left-0 text-ink-muted dark:text-night-muted group-hover:text-accent dark:group-hover:text-accent transition-colors"
              >
                ›
              </span>
              <span class="truncate transition group-hover:translate-x-1 group-hover:text-accent group-hover:underline underline-offset-4">
                {post.data.title}
              </span>
              <span class="shrink-0 text-xs text-ink-muted dark:text-night-muted tabular-nums">
                {post.data.createdAt}
              </span>
            </a>
          </li>
        ))
    }
  </ul>
</section>
