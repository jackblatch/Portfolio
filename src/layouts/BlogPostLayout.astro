---
import ArrowTopRightOnSquareIcon from "../components/ArrowTopRightOnSquareIcon.astro";
import BlogPostFooterCard from "../components/BlogPostFooterCard.astro";
import ContactMe from "../components/ContactMe.astro";
import NavBar from "../components/NavBar.astro";
import PersonalBio from "../components/PersonalBio.astro";
import SectionBreak from "../components/SectionBreak.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Layout from "./Layout.astro";

const { entry, headings = [] } = Astro.props;
---

<Layout title={`@jackblatch | ${entry.data.title}`}>
  <NavBar />
  <article>
    <h1 class="text-base font-medium tracking-tight">{entry.data.title}</h1>
    <p class="mt-2 text-xs text-ink-muted dark:text-night-muted tabular-nums">
      {entry.data.createdAt}
    </p>
    <p class="mt-4 text-sm text-ink-muted dark:text-night-muted">
      {entry.data.description}
    </p>
    <TableOfContents headings={headings} />
    <div class="prose dark:prose-invert mt-8">
      <slot />
    </div>
  </article>
  <SectionBreak />
  <PersonalBio />
  <div class="mt-6">
    <ContactMe />
  </div>
  <div
    class="mt-10 pt-6 border-t border-ink-line dark:border-night-line flex items-center justify-between text-sm"
  >
    <BlogPostFooterCard text="Go home" href="/" />
    <a
      href={`https://github.com/jackblatch/Portfolio/tree/main/src/content/blog/${entry.id}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2 text-ink-muted dark:text-night-muted hover:text-accent transition-colors"
      >Edit on GitHub <ArrowTopRightOnSquareIcon /></a
    >
  </div>
</Layout>
